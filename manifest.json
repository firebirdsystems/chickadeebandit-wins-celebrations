{
  "id": "wins-celebrations",
  "contexts": ["household", "shared_space"],
  "name": "Wins & Celebrations",
  "version": "1.0.1",
  "description": "Post a win — a grade, goal, or milestone — and let the whole family cheer you on.",
  "entrypoint": "index.html",
  "runtime": "static",
  "category": "general",
  "tags": [
    "wins",
    "celebrations",
    "family",
    "everyone",
    "kids"
  ],
  "data_access": {
    "reads": [
      "family.members"
    ],
    "writes": []
  },
  "permissions": {
    "default_audience": "everyone",
    "requires_approval": false
  },
  "storage": "db",
  "row_policies": {
    "wins": {
      "kind": "owner_or_visibility",
      "member_column": "author_id",
      "visibility_column": "visibility",
      "everyone_values": ["everyone"],
      "retain_days": {
        "default": 730,
        "timestamp_column": "created_at",
        "override_key": "win_history",
        "dependent_tables": [
          { "table": "win_reactions", "foreign_key": "win_id" },
          { "table": "win_comments", "foreign_key": "win_id" }
        ]
      }
    },
    "win_reactions": {
      "kind": "inherit_visibility",
      "parent_table": "wins",
      "fk_column": "win_id",
      "writer_column": "member_id",
      "max_per_member": {
        "member_column": "member_id",
        "scope_columns": ["win_id", "emoji"],
        "limit": 1
      }
    },
    "win_comments": {
      "kind": "inherit_visibility",
      "parent_table": "wins",
      "fk_column": "win_id",
      "writer_column": "author_id"
    }
  },
  "member_references": {
    "wins": { "column": "author_id", "on_removed": "keep" },
    "win_reactions": { "column": "member_id", "on_removed": "delete" },
    "win_comments": { "column": "author_id", "on_removed": "keep" }
  },
  "db_plaintext_columns": ["visibility"],
  "publish_acls": {
    "win.posted": { "require_role": "member" }
  },
  "publishes": [
    "win.posted"
  ],
  "alert_on": [
    "win.posted"
  ],
  "nav": { "label": "Wins" },
  "widget": {
    "label": "Wins",
    "size": "small"
  },
  "ai_access": {
    "allowed": true,
    "mode": "read",
    "db_exports": ["recent_wins"]
  },
  "icon": "🏆"
}
